{
  "id": "drive_oauth",
  "name": "Drive (OAuth2)",
  "name_en": "Drive (OAuth2)",
  "version": "1.0.0",
  "description": "Listar, leer, descargar y subir archivos en Google Drive (cuenta personal o Google Workspace individual) mediante OAuth2 con refresh token",
  "description_en": "List, read, download and upload files in Google Drive (personal account or individual Google Workspace user) using OAuth2 with a refresh token",
  "icon": "icon.svg",
  "category": "storage",
  "category_en": "storage",
  "keywords": ["drive", "google drive", "archivo", "archivos", "documento", "oauth", "oauth2", "google", "gmail personal"],
  "library": {
    "package": "ruvic-drive-oauth-connector",
    "install": "pip install git+https://github.com/Dgirto/Drive-OAuth.git#subdirectory=lib",
    "import_name": "ruvic_drive_oauth_connector"
  },
  "auth_modes": [
    {
      "id": "oauth2_platform",
      "label": "Autorizar con Google (recomendado)",
      "fields": [
        {
          "key": "refresh_token",
          "label": "Autorización de la cuenta",
          "type": "oauth2_authorization",
          "secret": true,
          "required": true,
          "oauth2": {
            "authorization_url": "https://accounts.google.com/o/oauth2/v2/auth",
            "token_url": "https://oauth2.googleapis.com/token",
            "scopes": ["https://www.googleapis.com/auth/drive", "openid", "email"],
            "extra_authorize_params": {
              "access_type": "offline",
              "prompt": "consent"
            },
            "pkce": true,
            "capture": "refresh_token",
            "identity_hint": "id_token.email",
            "client_credentials": "platform",
            "platform_provider": "google"
          },
          "help_text": "Guarda la instancia y pulsa Autorizar. Usa la app OAuth de Ruvic (RUVIC_OAUTH_GOOGLE_CLIENT_ID / RUVIC_OAUTH_GOOGLE_CLIENT_SECRET)."
        },
        {
          "key": "request_timeout",
          "label": "Timeout de solicitud (segundos)",
          "type": "number",
          "required": false,
          "default": "30"
        }
      ]
    },
    {
      "id": "oauth2",
      "label": "Usar credenciales propias",
      "fields": [
        {
          "key": "client_id",
          "label": "Client ID de OAuth",
          "type": "text",
          "required": true,
          "placeholder": "1234567890-abc123.apps.googleusercontent.com",
          "help_text": "ID del cliente OAuth (tipo 'Aplicación web') creado en Google Cloud Console. Registra como URI de redirección: {WEB_URL}/api/v1/connectors/oauth/callback"
        },
        {
          "key": "client_secret",
          "label": "Client Secret de OAuth",
          "type": "password",
          "secret": true,
          "required": true,
          "help_text": "Secreto del mismo cliente OAuth"
        },
        {
          "key": "refresh_token",
          "label": "Autorización de la cuenta",
          "type": "oauth2_authorization",
          "secret": true,
          "required": true,
          "oauth2": {
            "authorization_url": "https://accounts.google.com/o/oauth2/v2/auth",
            "token_url": "https://oauth2.googleapis.com/token",
            "scopes": ["https://www.googleapis.com/auth/drive", "openid", "email"],
            "extra_authorize_params": {
              "access_type": "offline",
              "prompt": "consent"
            },
            "pkce": true,
            "capture": "refresh_token",
            "identity_hint": "id_token.email",
            "client_credentials": "user"
          },
          "help_text": "Guarda la instancia con Client ID y Client Secret, luego pulsa Autorizar."
        },
        {
          "key": "request_timeout",
          "label": "Timeout de solicitud (segundos)",
          "type": "number",
          "required": false,
          "default": "30"
        }
      ]
    },
    {
      "id": "manual",
      "label": "Refresh token manual",
      "fields": [
        {
          "key": "client_id",
          "label": "Client ID de OAuth",
          "type": "text",
          "required": true,
          "placeholder": "1234567890-abc123.apps.googleusercontent.com",
          "help_text": "ID del cliente OAuth creado en Google Cloud Console"
        },
        {
          "key": "client_secret",
          "label": "Client Secret de OAuth",
          "type": "password",
          "secret": true,
          "required": true,
          "help_text": "Secreto del mismo cliente OAuth"
        },
        {
          "key": "refresh_token",
          "label": "Refresh token",
          "type": "password",
          "secret": true,
          "required": true,
          "help_text": "Obtenido una sola vez con get_refresh_token.py o pegando un token existente"
        },
        {
          "key": "request_timeout",
          "label": "Timeout de solicitud (segundos)",
          "type": "number",
          "required": false,
          "default": "30"
        }
      ]
    }
  ],
  "env_prefix": "RUVIC_DRIVE_OAUTH_",
  "operations": ["file.list", "file.read", "file.download", "file.upload"],
  "test_connection": true,
  "docs": {
    "skill": "SKILL.md",
    "permissions_note": "OAuth2 con scope drive (acceso completo de lectura y escritura al Drive del usuario que autoriza). Modo recomendado: Autorizar con Google (app OAuth de Ruvic). Alternativas: credenciales propias o refresh token manual. Funciona con cuentas de Google personales y con usuarios individuales de Google Workspace, sin necesitar superadministrador ni delegación de dominio. Para autorizar varios buzones/usuarios de un mismo dominio Workspace con una sola credencial administrada centralmente, usa en su lugar el conector Drive (Google Workspace — cuenta de servicio)."
  }
}
